+/// MMC5 mapper, minimal subset (PRG modes 0-3, PRG-RAM protect, CHR-RAM/ROM 8KB/4KB
+/// modes, nametable mapping incl. ExRAM/fill, ExRAM as CPU RAM, multiplier).
+/// No scanline IRQ / split screen / extended attributes.
+class MMC5 final : public Mapper {
+public:
+    MMC5(NES& nes, const ParsedMemory& metadata, MirroringMode mode);
+    ~MMC5() = default;
+    void write_cpu(uint16_t address, uint8_t value) override;
+    uint8_t read_cpu(uint16_t address) override;
+    void write_ppu(uint16_t address, uint8_t value) override;
+    uint8_t read_ppu(uint16_t address) override;
+    void stream_state(SaveState& save_state) override;
+    void tick() override;
+private:
+    void update_banks();
+    void update_irq();
+    uint8_t _irq_target, _irq_counter;
+    bool _irq_enabled, _irq_pending, _in_frame;
+    int _irq_last_line;
+    uint8_t _prg_mode, _chr_mode, _protect1, _protect2, _exram_mode, _nt_map;
+    uint8_t _fill_tile, _fill_attr, _mul_a, _mul_b;
+    uint8_t _prg[5];
+    uint16_t _chr[12];
+    uint8_t _chr_upper;
+    uint8_t _exram[0x400];
+};
+
 }
 
