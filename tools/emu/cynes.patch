+
+MMC5::MMC5(NES& nes, const ParsedMemory& metadata, MirroringMode mode)
+    : Mapper(nes, metadata, mode, 0x08, 0x02)
+    , _prg_mode{3}, _chr_mode{0}, _protect1{0}, _protect2{0}, _exram_mode{0}, _nt_map{0x44}
+    , _fill_tile{0}, _fill_attr{0}, _mul_a{0xFF}, _mul_b{0xFF}, _prg{}, _chr{}, _chr_upper{0}
+{
+    memset(_exram, 0, sizeof(_exram));
+    _prg[4] = 0xFF; _prg[3] = 0xFF; _prg[2] = 0xFF; _prg[1] = 0xFF;
+    update_banks();
+}
+
+void MMC5::update_banks() {
+    const uint16_t n8 = _banks_prg >> 3;           // number of 8KB PRG banks
+    auto m8 = [&](uint8_t page, uint8_t v) { map_bank_prg(page, 0x8, ((v & 0x7F) % n8) << 3); };
+    switch (_prg_mode & 3) {
+    case 0: { uint8_t b = _prg[4] & 0x7C; for (int i = 0; i < 4; i++) m8(0x20 + 8*i, b + i); break; }
+    case 1: { uint8_t a = _prg[2] & 0x7E, b = _prg[4] & 0x7E;
+              m8(0x20, a); m8(0x28, a + 1); m8(0x30, b); m8(0x38, b + 1); break; }
+    case 2: { uint8_t a = _prg[2] & 0x7E; m8(0x20, a); m8(0x28, a + 1); m8(0x30, _prg[3]); m8(0x38, _prg[4]); break; }
+    default: m8(0x20, _prg[1]); m8(0x28, _prg[2]); m8(0x30, _prg[3]); m8(0x38, _prg[4]); break;
+    }
+    bool ro = !(_protect1 == 2 && _protect2 == 1);
+    map_bank_cpu_ram(0x18, 0x8, 0x0, ro);
+
+    const uint16_t nchr = _banks_chr;              // 1KB units
+    auto mc = [&](uint8_t page, uint8_t size, uint32_t kb) {
+        for (uint8_t i = 0; i < size; i++) map_bank_chr(page + i, static_cast<uint16_t>((kb + i) % nchr));
+    };
+    switch (_chr_mode & 3) {
+    case 0: mc(0, 8, _chr[7] * 8u); break;
+    case 1: mc(0, 4, _chr[3] * 4u); mc(4, 4, _chr[7] * 4u); break;
+    case 2: for (int i = 0; i < 4; i++) mc(2*i, 2, _chr[2*i+1] * 2u); break;
+    default: for (int i = 0; i < 8; i++) mc(i, 1, _chr[i]); break;
+    }
+    for (int i = 0; i < 4; i++) {
+        uint8_t m = (_nt_map >> (2*i)) & 3;
+        map_bank_ppu_ram(0x8 + i, m == 1 ? 1 : 0, false);
+        map_bank_ppu_ram(0xC + i, m == 1 ? 1 : 0, false);
+    }
+}
+
+void MMC5::write_cpu(uint16_t address, uint8_t value) {
+    if (address >= 0x5C00 && address < 0x6000) { if (_exram_mode != 3) _exram[address - 0x5C00] = value; return; }
+    if (address >= 0x5000 && address < 0x5C00) {
+        switch (address) {
+        case 0x5100: _prg_mode = value & 3; break;
+        case 0x5101: _chr_mode = value & 3; break;
+        case 0x5102: _protect1 = value & 3; break;
+        case 0x5103: _protect2 = value & 3; break;
+        case 0x5104: _exram_mode = value & 3; break;
+        case 0x5105: _nt_map = value; break;
+        case 0x5106: _fill_tile = value; break;
+        case 0x5107: _fill_attr = value & 3; break;
+        case 0x5130: _chr_upper = value & 3; break;
+        case 0x5205: _mul_a = value; break;
+        case 0x5206: _mul_b = value; break;
+        default:
+            if (address >= 0x5113 && address <= 0x5117) _prg[address - 0x5113] = value;
+            else if (address >= 0x5120 && address <= 0x512B) _chr[address - 0x5120] = value | (_chr_upper << 8);
+            break;
+        }
+        update_banks();
+        return;
+    }
+    if (address >= 0x8000) {  // ROM
+        if (std::getenv("MMC5_LOG")) fprintf(stderr, "ROMWRITE %04X=%02X\n", address, value);
+        return;
+    }
+    Mapper::write_cpu(address, value);
+}
+
+uint8_t MMC5::read_cpu(uint16_t address) {
+    if (address >= 0x5C00 && address < 0x6000) return _exram_mode >= 2 ? _exram[address - 0x5C00] : 0;
+    if (address == 0x5204) return 0x40;
+    if (address == 0x5205) return static_cast<uint8_t>((_mul_a * _mul_b) & 0xFF);
+    if (address == 0x5206) return static_cast<uint8_t>((_mul_a * _mul_b) >> 8);
+    if (address >= 0x5000 && address < 0x6000) return 0;
+    return Mapper::read_cpu(address);
+}
+
+void MMC5::write_ppu(uint16_t address, uint8_t value) {
+    if (address >= 0x2000) {
+        uint8_t m = (_nt_map >> (((address >> 10) & 3) * 2)) & 3;
+        if (m == 2) { _exram[address & 0x3FF] = value; return; }
+        if (m == 3) return;
+    }
+    Mapper::write_ppu(address, value);
+}
+
+uint8_t MMC5::read_ppu(uint16_t address) {
+    if (address >= 0x2000) {
+        uint8_t m = (_nt_map >> (((address >> 10) & 3) * 2)) & 3;
+        if (m == 2) return _exram[address & 0x3FF];
+        if (m == 3) return (address & 0x3FF) >= 0x3C0 ? static_cast<uint8_t>(_fill_attr * 0x55) : _fill_tile;
+    }
+    return Mapper::read_ppu(address);
+}
+
+void MMC5::stream_state(SaveState& save_state) {
+    Mapper::stream_state(save_state);
+    save_state.stream(_prg_mode); save_state.stream(_chr_mode); save_state.stream(_protect1);
+    save_state.stream(_protect2); save_state.stream(_exram_mode); save_state.stream(_nt_map);
+    save_state.stream(_fill_tile); save_state.stream(_fill_attr); save_state.stream(_mul_a);
+    save_state.stream(_mul_b); save_state.stream(_prg); save_state.stream(_chr);
+    save_state.stream(_chr_upper); save_state.stream(_exram);
+}
