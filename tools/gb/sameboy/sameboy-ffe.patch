     environ_cb(RETRO_ENVIRONMENT_SET_MEMORY_MAPS, &mmaps);
 }
 
+
+/* FFE scratch patch: SB_PCLOG=hex,hex... prints LY and the line's cycle when bank-0 code reaches them */
+static uint16_t pclog_a[16]; static unsigned pclog_n = 0;
+static void pclog_cb(GB_gameboy_t *gb, uint16_t address, uint8_t opcode)
+{
+    for (unsigned i = 0; i < pclog_n; i++) if (pclog_a[i] == address) {
+        fprintf(stderr, "PC %02X:%04X LY %d\n", address < 0x4000 ? 0 : gb->mbc_rom_bank, address, gb->current_line);
+    }
+}
 static void init_for_current_model(unsigned id)
 {
     unsigned i = id;
@@ -752,6 +761,11 @@ static void init_for_current_model(unsigned id)
 
     /* todo: attempt to make these more generic */
     GB_set_vblank_callback(&gameboy[0], (GB_vblank_callback_t) vblank1);
+    if (getenv("SB_PCLOG")) {
+        char *e = getenv("SB_PCLOG");
+        while (*e && pclog_n < 16) { pclog_a[pclog_n++] = strtoul(e, &e, 16); if (*e == ',') e++; }
+        GB_set_execution_callback(&gameboy[0], pclog_cb);
+    }
     GB_set_lcd_status_callback(&gameboy[0], lcd_status_change_1);
     if (emulated_devices == 2) {
         GB_set_vblank_callback(&gameboy[1], (GB_vblank_callback_t) vblank2);
