+/* FFE scratch patch: SB_PCLOG=hex,hex... prints LY and the line's cycle when bank-0 code reaches them */
+static uint16_t pclog_a[16]; static unsigned pclog_n = 0;
+static void pclog_cb(GB_gameboy_t *gb, uint16_t address, uint8_t opcode)
+{
+    for (unsigned i = 0; i < pclog_n; i++) if (pclog_a[i] == address) {
+        fprintf(stderr, "PC %02X:%04X LY %d\n", address < 0x4000 ? 0 : gb->mbc_rom_bank, address, gb->current_line);
+    }
+}
+static unsigned watch_lo = 0, watch_hi = 0;
+static bool watch_cb(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
+{
+    if (addr >= watch_lo && addr <= watch_hi) {
+        uint16_t sp = gb->sp;
+        fprintf(stderr, "W %04X=%02X PC %02X:%04X SP %04X LY %d stk %02X%02X %02X%02X %02X%02X\n", addr, value,
+                gb->pc < 0x4000 ? 0 : gb->mbc_rom_bank, gb->pc, sp, gb->current_line,
+                GB_safe_read_memory(gb, sp + 1), GB_safe_read_memory(gb, sp), GB_safe_read_memory(gb, sp + 3), GB_safe_read_memory(gb, sp + 2),
+                GB_safe_read_memory(gb, sp + 5), GB_safe_read_memory(gb, sp + 4));
+    }
+    return true;
+}
