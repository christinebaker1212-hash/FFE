diff --git a/Core/memory.c b/Core/memory.c
index 876a717..b678428 100644
--- a/Core/memory.c
+++ b/Core/memory.c
@@ -1014,10 +1014,19 @@ static void write_mbc(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
     GB_update_mbc_mappings(gb);
 }
 
+
+/* FFE patch: count CPU writes the hardware drops (VRAM in mode 3, OAM in modes 2/3) */
+#include <stdio.h>
+__attribute__((visibility("default"))) unsigned GB_vchk_n = 0;
+static void vchk_note(GB_gameboy_t *gb, uint16_t addr)
+{
+    if (GB_vchk_n++ < 40) fprintf(stderr, "VCHK %04X pc %02X:%04X LY %d\n", addr, gb->pc < 0x4000 ? 0 : gb->mbc_rom_bank, gb->pc, gb->current_line);
+}
 static void write_vram(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
 {
     GB_display_sync(gb);
     if (unlikely(gb->vram_write_blocked)) {
+        vchk_note(gb, addr);
         //GB_log(gb, "Wrote %02x to %04x (VRAM) during mode 3\n", value, addr);
         return;
     }
@@ -1373,6 +1382,7 @@ static void write_high_memory(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
     if (addr < 0xFF00) {
         GB_display_sync(gb);
         if (gb->oam_write_blocked) {
+            vchk_note(gb, addr);
             GB_trigger_oam_bug(gb, addr);
             return;
         }
diff --git a/libretro/libretro.c b/libretro/libretro.c
