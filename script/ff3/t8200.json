  "ja": "{14:01}{10:02}",
  "en": ""
 },
 {
  "id": 110,
  "off": "36BCD",
  "ja": "　そうびをはずしました",
  "en": ""
 },
 {
  "id": 111,
  "off": "36BD9",
  "ja": "　そうびできません",
  "en": ""
 },
 {
  "id": 112,
  "off": "36BE3",
  "ja": "　　　　ジョブチェンジしますか?\n　　　エー‥はい　　ビー‥いいえ",
  "en": ""
 },
 {
  "id": 113,
  "off": "36C05",
  "ja": "　すべてのそうびをはずさないとジョブチェンジ\n　できません。",
  "en": ""
 },
 {
  "id": 114,
  "off": "36C24",
  "ja": "　　　　　キャパシティがたりません!",
  "en": ""
 },
 {
  "id": 115,
