  "en": ""
 },
 {
  "id": 118,
  "off": "36C67",
  "ja": "　こんなところに　{02}が!",
  "en": ""
 },
 {
  "id": 119,
  "off": "36C74",
  "ja": "　せまくて　おおきくなれません",
  "en": ""
 },
 {
  "id": 120,
  "off": "36C84",
  "ja": "　ワープふかのう",
  "en": ""
 },
 {
  "id": 121,
  "off": "36C8D",
  "ja": "　まほうがつかえない",
  "en": ""
 },
 {
  "id": 122,
  "off": "36C98",
  "ja": "　シーフの　とくしゅのうりょくで\n　あっさり　かぎが　あいた!",
  "en": ""
