 {
  "id": 75,
  "off": "3697F",
  "ja": "セーブするファイルをえらんでください",
  "en": ""
 },
 {
  "id": 76,
  "off": "36992",
  "ja": "まえのデーターをけします{15:0E}はい{15:12}いいえ",
  "en": ""
 },
 {
  "id": 77,
  "off": "369A8",
  "ja": "セーブしゅうりょうしました",
  "en": ""
 },
 {
  "id": 78,
  "off": "369B6",
  "ja": "リセットをおしながらスイッチをきりましょう",
  "en": ""
 },
 {
  "id": 79,
  "off": "369CC",
  "ja": "ありがとうございます。　ごゆっくり‥‥",
  "en": ""
 },
 {
  "id": 80,
  "off": "369E0",
  "ja": "もちものがいっぱいです",
  "en": ""
 },
 {
  "id": 81,
  "off": "369EC",
  "ja": "でぶチョコボ:「よーお　なんかようかーい?",
  "en": ""
 },
 {
  "id": 82,
  "off": "36A02",
  "ja": "「なにをくれるんだーい?",
  "en": ""
 },
 {
  "id": 83,
  "off": "36A0F",
  "ja": "「なにがほしいんだってー?",
  "en": ""
 },
 {
  "id": 84,
  "off": "36A1D",
  "ja": "「いっただっきまーす。　むしゃむしゃ‥",
  "en": ""
 },
 {
  "id": 85,
  "off": "36A31",
  "ja": "「これいじょう　おなじもんはくえねえよ",
  "en": ""
 },
 {
  "id": 86,
  "off": "36A45",
  "ja": "「もちものがいっぱいで　かえせねえなあ",
  "en": ""
 },
 {
  "id": 87,
  "off": "36A59",
  "ja": "「かえしきれないので　のこりはあずかっとくよ",
  "en": ""
 },
 {
  "id": 88,
  "off": "36A70",
  "ja": "「ちょっとまってね　いまだすから‥",
  "en": ""
 },
 {
  "id": 89,
  "off": "36A82",
  "ja": "　たからばこのなかには\n　{02}がはいっていた!",
  "en": ""
 },
 {
  "id": 90,
  "off": "36A99",
  "ja": "つかうことができません",
  "en": ""
 },
 {
  "id": 91,
  "off": "36AA5",
  "ja": "だれの[77][79]をかいふくしますか?",
  "en": ""
 },
 {
  "id": 92,
  "off": "36AB5",
  "ja": "だれの[77][79]をかいふくしますか?",
  "en": ""
 },
 {
  "id": 93,
  "off": "36AC5",
  "ja": "だれをかんぜんにかいふくしますか?",
  "en": ""
 },
 {
  "id": 94,
  "off": "36AD7",
  "ja": "だれをいきかえらせますか?",
  "en": ""
 },
 {
  "id": 95,
  "off": "36AE5",
  "ja": "いしのじょうたいをかいふくします",
  "en": ""
 },
 {
  "id": 96,
  "off": "36AF6",
  "ja": "かえるになってしまったひとをもどします",
  "en": ""
 },
 {
  "id": 97,
  "off": "36B0A",
  "ja": "ちんもくをかいふくします",
  "en": ""
 },
 {
  "id": 98,
  "off": "36B17",
  "ja": "こびとにしたり　もどしたりします",
  "en": ""
 },
 {
  "id": 99,
  "off": "36B28",
  "ja": "しりょくをかいふくします",
  "en": ""
 },
 {
  "id": 100,
  "off": "36B35",
  "ja": "だれのどくをなおしますか?",
  "en": ""
 },
 {
  "id": 101,
  "off": "36B43",
  "ja": "おもてにワープします",
  "en": ""
 },
 {
  "id": 102,
  "off": "36B4E",
  "ja": "だれのステータスをなおしますか?",
  "en": ""
 },
 {
  "id": 103,
  "off": "36B5F",
  "ja": "いくつまえにもどりますか?　",
  "en": ""
 },
 {
  "id": 104,
  "off": "36B6E",
  "ja": "おもてにワープします",
  "en": ""
 },
 {
  "id": 105,
  "off": "36B79",
  "ja": "かえるにしたり　もどしたりします　ひとり/ぜんいん",
  "en": ""
 },
 {
  "id": 106,
  "off": "36B93",
  "ja": "こびとにしたり　もどしたりします　ひとり/ぜんいん",
  "en": ""
 },
 {
  "id": 107,
  "off": "36BAD",
  "ja": "もちものがいっぱいではずせません",
  "en": ""
 },
 {
  "id": 108,
  "off": "36BBE",
  "ja": "おかねがたりません",
  "en": ""
 },
